{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C Application",
            "type": "cppdbg",
            "request": "launch",
            // Points directly to the executable generated by CMake
            "program": "${workspaceFolder}/build/Learn-C.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "console": "integratedTerminal",
            "MIMode": "gdb",
            // Points to your MinGW GDB installation
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // Builds the project automatically before launching the debugger
            "preLaunchTask": "CMake: Build"
        }
    ]
}